    {
      "name": "Red wire with voltage in Plug",
      "enabled": true,
      "stop": true,
      "conditions": [
        {
          "column": "L",
          "op": "contains",
          "value": "RED"
        },
        {
          "column": "J",
          "op": "regex",
          "value": "(\\d+(?:\\.\\d+)?)\\s*V\\b"
        }
      ],
      "assignments": [
        {
          "column": "N",
          "value": "{g1}"
        },
        {
          "column": "O",
          "value": "P"
        }
      ]
    },
    {
      "name": "RTN plug",
      "enabled": true,
      "stop": true,
      "conditions": [
        {
          "column": "J",
          "op": "contains",
          "value": "RTN"
        }
      ],
      "assignments": [
        {
          "column": "N",
          "value": "0"
        },
        {
          "column": "P",
          "value": "0"
        },
        {
          "column": "Q",
          "value": "G"
        }
      ]
    },
    {
      "name": "GND plug",
      "enabled": true,
      "stop": true,
      "conditions": [
        {
          "column": "J",
          "op": "contains",
          "value": "GND"
        }
      ],
      "assignments": [
        {
          "column": "N",
          "value": "0"
        },
        {
          "column": "P",
          "value": "0"
        },
        {
          "column": "Q",
          "value": "G"
        }
      ]
    },
    {
      "name": "Black CH. minus pin",
      "enabled": true,
      "stop": true,
      "conditions": [
        {
          "column": "K",
          "op": "contains",
          "value": "CH."
        },
        {
          "column": "K",
          "op": "contains",
          "value": "-"
        }
      ],
      "assignments": [
        {
          "column": "N",
          "value": "0"
        },
        {
          "column": "P",
          "value": "0"
        },
        {
          "column": "Q",
          "value": "G"
        }
      ]
    },
    {
      "name": "Red CH. plus pin (voltage from From range)",
      "enabled": true,
      "stop": true,
      "conditions": [
        {
          "column": "L",
          "op": "equals",
          "value": "RED"
        },
        {
          "column": "K",
          "op": "contains",
          "value": "CH"
        },
        {
          "column": "K",
          "op": "contains",
          "value": "+"
        }
      ],
      "assignments": [
        {
          "column": "N",
          "value": "{j|rangemax}"
        },
        {
          "column": "O",
          "value": "TBD_CH+"
        }
      ]
    },
    {
      "name": "ENCX A+ on P1",
      "enabled": true,
      "stop": true,
      "conditions": [
