  "rules": [
    {
      "name": "DI rows - not Matrix connect to 24 RTN",
      "enabled": true,
      "stop": true,
      "conditions": [
        {
          "column": "B",
          "op": "code_number",
          "value": "di"
        },
        {
          "column": "C",
          "op": "regex",
          "value": "^(?!.*(?:X|Y)\\d+)"
        }
      ],
      "assignments": [
        {
          "column": "N",
          "value": "3.5"
        },
        {
          "column": "R",
          "value": "{H@J=24V I\\O RTN}"
        },
        {
          "column": "T",
          "value": "C{A|num}_DI{g1}_0"
        }
      ]
    },
    {
      "name": "DI rows - Matrix",
      "enabled": true,
      "stop": true,
      "conditions": [
        {
          "column": "B",
          "op": "code_number",
          "value": "di"
        },
        {
          "column": "C",
          "op": "regex",
          "value": "(?!.*(?:X|Y)\\d+)"
        }
      ],
      "assignments": [
        {
          "column": "N",
          "value": "3.5"
        }
      ]
    },
    {
      "name": "DI rows - RTN pin",
      "enabled": true,
      "stop": true,
      "conditions": [
        {
          "column": "B",
          "op": "code_number",
          "value": "di"
        }
      ],
      "assignments": [
        {
          "column": "R",
          "value": "{H@J=24V I\\O RTN}"
        }
      ]
    },
    {
      "name": "DO rows - not Matrix",
      "enabled": true,
      "stop": true,
      "conditions": [
        {
          "column": "B",
          "op": "code_number",
          "value": "do"
        },
        {
          "column": "C",
          "op": "regex",
          "value": "^(?!.*(?:X|Y)\\d+)"
        }
      ],
      "assignments": [
        {
          "column": "N",
          "value": "0"
        },
        {
          "column": "P",
          "value": "4"
        },
        {
          "column": "Q",
          "value": "C{A|num}_DO{g1}_1"
        }
      ]
    },
    {
      "name": "DO rows - Matrix",
      "enabled": true,
      "stop": true,
      "conditions": [
        {
          "column": "B",
          "op": "code_number",
          "value": "do"
        },
        {
          "column": "C",
          "op": "regex",
          "value": "[XY]\\d+"
        }
      ],
      "assignments": [
        {
          "column": "N",
          "value": "0"
        },
        {
          "column": "P",
          "value": "4"
        },
        {
          "column": "Q",
          "value": "C{A|num}_DO{g1}_1"
        },
        {
          "column": "R",
          "value": "TBD_DI"
        },
        {
          "column": "S",
          "value": "C{A|num}_DO{g1}_1"
        },
        {
          "column": "T",
          "value": "C{A|num}_DI_TBD_0"
        }
      ]
    },
    {
      "name": "AI rows",
      "enabled": true,
      "stop": false,
      "conditions": [
        {
          "column": "B",
          "op": "code_number",
          "value": "ai"
        }
      ],
      "assignments": [
        {
          "column": "N",
          "value": "1"
        },
        {
          "column": "R",
          "value": "TBD_AI"
        },
        {
          "column": "T",
          "value": "C{A|num}_AI{g1}_10"
        }
      ]
    },
    {
      "name": "AI rows - 10V pin",
      "enabled": true,
      "stop": true,
      "conditions": [
        {
          "column": "B",
          "op": "code_number",
          "value": "ai"
        }
      ],
      "assignments": [
        {
          "column": "R",
          "value": "{H@N==10}"
        }
      ]
    },
    {
      "name": "DIM CARD 0-5V_CONSOLE -> Analog input",
      "enabled": true,
      "stop": true,
      "conditions": [
        {
          "column": "J",
          "op": "contains",
          "value": "DIM CARD 0-5V_CONSOLE"
        },
        {
          "column": "K",
          "op": "contains",
          "value": "CH.2+"
        }
      ],
      "assignments": [
        {
          "column": "O",
          "value": "C1_AO2_10"
        },
        {
          "column": "N",
          "value": "5"
        }
      ]
    },
    {
