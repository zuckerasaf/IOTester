        },
        {
          "column": "K",
          "op": "contains",
          "value": "CH.1+"
        }
      ],
      "assignments": [
        {
          "column": "O",
          "value": "C1_AO1_10"
        },
        {
          "column": "N",
          "value": "5"
        }
      ]
    },
    {
      "name": "DIM CARD 0-28V_BRT DIM -> Analog input",
      "enabled": true,
      "stop": true,
      "conditions": [
        {
          "column": "J",
          "op": "contains",
          "value": "DIM CARD 0-28V_BRT DIM"
        },
        {
          "column": "K",
          "op": "contains",
