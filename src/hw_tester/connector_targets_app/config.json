        {
          "column": "K",
          "op": "contains",
          "value": "+"
        }
      ],
      "assignments": [
        {
          "column": "O",
          "value": "C1_AO1_10"
        },
        {
          "column": "N",
          "value": "5"
        }
      ]
    },
    {
      "name": "DIM CARD 0-5V -> Analog input",
      "enabled": true,
